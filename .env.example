# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN AI AGENT SYSTEM
# Hãy thay thế các giá trị bên dưới bằng mã thực tế của bạn:

# 1. Mã Gemini API Key (Miễn phí tại https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# 2. Mã Bot Telegram (Nhận từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 3. ID Telegram cá nhân của bạn (Dùng để bảo mật, chỉ nhận lệnh từ bạn)
TELEGRAM_ALLOWED_USER_ID=YOUR_TELEGRAM_ID_HERE

# 4. Access Tokens Fanpage Facebook (Phân cách bằng dấu phẩy)
FACEBOOK_PAGE_TOKENS=PAGE_TOKEN_1,PAGE_TOKEN_2
